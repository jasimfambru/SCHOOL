rules_version = '2';

// Nagarjuna Public School - Firestore security rules.
//
// Anyone can read the events (the public website needs them).
// Only people on the staff list can create, edit or delete events.
// A person is on the staff list when a document exists at staff/{their user id}.
// Staff documents can only be created in the Firebase console, never from the website.
service cloud.firestore {
  match /databases/{database}/documents {

    function isStaff() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update: if isStaff()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 20000;
      allow delete: if isStaff();
    }

    // A signed-in user may read only their own staff record (used to confirm they are staff).
    match /staff/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
