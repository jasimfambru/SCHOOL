rules_version = '2';

// Nagarjuna Public School - Cloud Storage security rules.
//
// Anyone can view event photos. Only staff can upload or delete them,
// and uploads must be images under 10 MB.
service firebase.storage {
  match /b/{bucket}/o {
    function isStaff() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/staff/$(request.auth.uid));
    }

    match /events/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff()
        && request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isStaff();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
